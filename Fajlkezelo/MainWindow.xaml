<Window x:Class="Fajlkezelo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fajlkezelo"
        mc:Ignorable="d"
        Title="Fájlkezelő"
        Width="1100"
        Height="680"
        MinWidth="760"
        MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="#171B24"
        Foreground="#E8ECF2">

    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#303B4E"/>
            <Setter Property="Foreground" Value="#F2F5FA"/>
            <Setter Property="BorderBrush" Value="#46546A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#40536E"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#243147"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#E8ECF2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#303A4C"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2463A6"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Felső sáv -->
        <Border Grid.Row="0"
                Background="#212936"
                BorderBrush="#39465A"
                BorderThickness="0,0,0,1">

            <DockPanel Margin="18,0">
                <StackPanel DockPanel.Dock="Left"
                            VerticalAlignment="Center">
                    <TextBlock Text="FÁJLKEZELŐ"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#F4F7FB"/>

                    <TextBlock Text="Mappák és fájlok kezelése"
                               FontSize="11"
                               Foreground="#9EACC0"/>
                </StackPanel>

                <Button x:Name="NewFolder"
                        Content="📁  Új mappa"
                        Click="NewFolder_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Aktuális útvonal -->
        <Border Grid.Row="1"
                Background="#1D2430"
                BorderBrush="#39465A"
                BorderThickness="0,0,0,1">

            <DockPanel Margin="18,0"
                       VerticalAlignment="Center">
                <TextBlock Text="HELY:"
                           Foreground="#8FA4C0"
                           FontSize="11"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <Border Background="#121923"
                        BorderBrush="#3A495F"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,6">

                    <Label x:Name="currentLabel"
                           Content=""
                           Foreground="#DDE8F7"
                           Padding="0"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- Fájllista és előnézet -->
        <Grid Grid.Row="2" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="250"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <!-- Bal panel -->
            <Border Grid.Column="0"
                    Background="#202936"
                    BorderBrush="#3A485C"
                    BorderThickness="1"
                    CornerRadius="5">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#2A3545"
                            BorderBrush="#3A485C"
                            BorderThickness="0,0,0,1">

                        <TextBlock Text="FÁJLOK ÉS MAPPÁK"
                                   VerticalAlignment="Center"
                                   Margin="14,0"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#B8CCE5"/>
                    </Border>

                    <ListBox x:Name="fajllista"
                             Grid.Row="1"
                             SelectionChanged="ListBox_SelectionChanged"
                             IsSynchronizedWithCurrentItem="True"
                             Background="#202936"
                             BorderThickness="0"
                             Foreground="#E8ECF2"
                             FontSize="14"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>

            <!-- Húzható elválasztó -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="#171B24"
                          ShowsPreview="True"/>

            <!-- Jobb panel -->
            <Border Grid.Column="2"
                    Background="#202936"
                    BorderBrush="#3A485C"
                    BorderThickness="1"
                    CornerRadius="5">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#2A3545"
                            BorderBrush="#3A485C"
                            BorderThickness="0,0,0,1">

                        <TextBlock Text="FÁJL ELŐNÉZETE"
                                   VerticalAlignment="Center"
                                   Margin="14,0"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#B8CCE5"/>
                    </Border>

                    <RichTextBox x:Name="szoveg"
                                 Grid.Row="1"
                                 TextChanged="szoveg_TextChanged"
                                 Background="#202936"
                                 Foreground="#E8ECF2"
                                 BorderThickness="0"
                                 Padding="12"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"/>

                    <Border Grid.Row="2"
                            Background="#2A3545"
                            BorderBrush="#3A485C"
                            BorderThickness="0,1,0,0"
                            Padding="12,9">

                        <TextBlock x:Name="fajlInformacio"
                                   Text="Nincs megnyitott fájl"
                                   Foreground="#B8CCE5"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Alsó információs sáv -->
        <Border Grid.Row="3"
                Background="#212936"
                BorderBrush="#39465A"
                BorderThickness="0,1,0,0">

            <TextBlock Text="Dupla kattintás: megnyitás    •    .. : visszalépés"
                       VerticalAlignment="Center"
                       Margin="18,0"
                       FontSize="11"
                       Foreground="#A9B9CD"/>
        </Border>
    </Grid>
</Window>